# Copy to /etc/sazcord-notify.env (root:root, mode 0640) and fill in.
# Without this file sazcord-notify.sh silently no-ops.

# Bot token issued by @BotFather.
TG_BOT_TOKEN=

# Chat ID(s) where alerts go (negative for groups/channels).
# Comma-separated list — message will be sent to each.
# Example: TG_CHAT_ID=-1001234567890,123456789
TG_CHAT_ID=

# Optional: your instance URL to display in notifications (default: https://sazcord.example.com)
# SAZCORD_URL=https://sazcord.example.com

# Optional HTTPS proxy if api.telegram.org is blocked from this host.
# TG_PROXY=http://127.0.0.1:7890
