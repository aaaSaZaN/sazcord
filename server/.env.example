# =====================================================================
# Sazcord server config. Скопируй этот файл в server/.env и поправь.
# =====================================================================

# HTTP-порт и сетевой интерфейс. Если поднимаешь за nginx/Caddy — оставь 3001
# и раскомментируй HOST=127.0.0.1, чтобы закрыть прямой доступ к Node из интернета.
PORT=3001
# HOST=127.0.0.1

# В production NODE_ENV=production обязателен — он включает строгий CSP,
# отключает CORS-вседозволенность и заставляет сервер падать на старте,
# если JWT_SECRET слабый/не задан. systemd-юнит из deploy/ его выставляет.
# NODE_ENV=production

# Секрет для подписи JWT-токенов. ОБЯЗАТЕЛЬНО смени на длинную случайную
# строку (например: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))").
# В production сервер откажется стартовать без секрета >= 16 символов.
# При смене все пользователи вылогинятся — это нормально.
JWT_SECRET=change-me-please-to-a-long-random-string

# Срок жизни токена. По умолчанию `never` — токен не истекает, юзер
# остаётся залогинен пока сам не выйдет (UX-приоритет, особенно для
# десктоп-клиента). При компрометации секрета ротируй JWT_SECRET —
# это инвалидирует все выданные токены за один шаг.
#
# Если хочется поведение прежних версий (14 дней), раскомментируй ниже.
# Формат — любой, который понимает jsonwebtoken: '7d', '24h', '30m'.
# Спец. значения 'never' | 'none' | '0' = без срока.
# JWT_TTL=14d

# --- CORS / разрешённые домены --------------------------------------
# --- Доверие к X-Forwarded-For --------------------------------------
# Сколько прокси стоит перед сервером. По умолчанию 1 — обычный случай
# «nginx/Caddy на том же хосте». Express берёт адрес клиента из
# X-Forwarded-For, иначе rate-limit считает все запросы пришедшими с
# одного IP (loopback от прокси) и режет всех разом.
#
# Подделать заголовок нельзя ровно при двух условиях:
#   1. прокси ДОПИСЫВАЕТ реальный адрес в конец цепочки — у nginx это
#      $proxy_add_x_forwarded_for, у Caddy поведение по умолчанию;
#   2. до node нельзя достучаться в обход прокси, то есть HOST=127.0.0.1.
# Если оба не выполнены, rate-limit обходится подделкой заголовка.
#
# TRUST_PROXY=false — node смотрит в интернет напрямую, без прокси.
# Тогда адрес берётся из сокета и подделать его нельзя в принципе.
# TRUST_PROXY=1

# Список фронтенд-доменов через запятую, которым разрешено стучаться
# в API и подключаться к WebSocket. Если переменная не задана:
#  - в dev (NODE_ENV != production) — разрешены все origin'ы (удобно);
#  - в production — все кросс-доменные запросы блокируются.
# Same-origin (фронт раздаётся с того же сервера, что и бэкенд) работает
# в любом случае без явного APP_ORIGIN.
# APP_ORIGIN=https://sazcord.example.com

# --- Регистрация ----------------------------------------------------
# По умолчанию сервер ЗАКРЫТ, настраивать ничего не нужно:
#   - пока в базе нет ни одного аккаунта, первый регистрируется свободно
#     и становится админом (id=1). Заведи его сразу после установки, до
#     того как адрес узнают посторонние;
#   - после этого нужен инвайт: общий код ниже либо персональная ссылка
#     из настроек («Приглашения»).
#
# Общий код: клиент должен прислать ровно эту строку при регистрации.
# Раздавай только доверенным людям, ротируется правкой .env + рестартом.
# REGISTRATION_CODE=ourSecretCode2025

# Осознанно открыть регистрацию всем желающим (публичный инстанс).
# Заданный REGISTRATION_CODE и живые приглашения сильнее этого флага —
# то есть выпущенная ссылка не перестаёт работать молча.
# REGISTRATION_OPEN=1

# Полностью закрыть регистрацию, даже с кодом (например, когда все нужные
# пользователи уже создали аккаунты). Принимаемые значения: 1, true, yes.
# REGISTRATION_DISABLED=1

# Кто может выпускать приглашения:
#   admins (по умолчанию) — только администраторы.
#   members — любой участник, но ТОЛЬКО одноразовые и со сроком 7 дней.
#     Смысл — цепочка доверия на домашнем инстансе: админ зовёт друзей,
#     друзья зовут своих, и админу не приходится работать швейцаром.
#     Многоразовые коды остаются за админом: такой код, утёкший в
#     публичный чат, открывает сервер всем подряд.
# INVITE_WHO_CAN_CREATE=admins

# Список username'ов, которые считаются администраторами. Им доступна
# вкладка «Приглашения» в настройках, где можно выпускать одноразовые/
# multi-use коды без перезапуска сервера. CSV, регистр не важен.
# Если переменная не задана, админом считается пользователь с id=1
# (т.е. первый зарегистрированный). На большинстве маленьких инсталляций
# этого достаточно.
# ADMIN_USERNAMES=alice,bob

# --- Загрузки: размер одного файла ----------------------------------
# Максимальный размер одного вложения в мегабайтах. По умолчанию 500.
# MAX_UPLOAD_MB=500

# Аватар и голосовое сообщение лимитируются отдельно — они по своей
# природе мелкие, и общий потолок для них слишком щедрый.
# AVATAR_MAX_MB=3
# VOICE_MAX_MB=15

# --- Загрузки: сколько места занимать в сумме -----------------------
# ВАЖНО: без этих лимитов объём вложений ничем не ограничен. MAX_UPLOAD_MB
# режет только ОДИН файл, а заливать такие файлы можно сколько угодно.
# Заполненный диск роняет не только загрузки: SQLite перестаёт дописывать
# WAL, и встаёт весь сервер целиком — сообщения, логин, всё.
#
# Пустое значение или 0 = ограничение выключено.

# Потолок на все вложения разом.
# UPLOADS_MAX_TOTAL_MB=10240

# Потолок на одного отправителя. Мешает одному человеку занять всё место.
# UPLOADS_MAX_PER_USER_MB=2048

# Жёсткий стоп: не принимать загрузки, если свободного места на разделе
# останется меньше. Это страховка сервера от самоубийства, а не про
# справедливый делёж — поэтому включена по умолчанию (500 МБ).
# UPLOADS_MIN_FREE_DISK_MB=500

# Что делать, когда упёрлись в UPLOADS_MAX_TOTAL_MB:
#   reject — отказать в загрузке (по умолчанию, предсказуемо)
#   evict  — удалять самые старые вложения, пока не влезет
# evict работает как кольцевой буфер и НЕ применяется к личной квоте:
# чужие файлы не удаляются из-за того, что кто-то исчерпал свою.
# UPLOADS_OVER_QUOTA=reject

# --- Пути к данным и файлам (опционально) ---------------------------
# Путь к файлу базы данных SQLite. По умолчанию: server/data/sazcord.sqlite
# SAZCORD_DB_FILE=/path/to/sazcord.sqlite

# Папка для загружаемых вложений (аватары, голос, файлы). По умолчанию: server/uploads
# UPLOADS_DIR=/path/to/uploads

# Папка со статикой обновлений десктопа/мобильного клиента. По умолчанию: updates/
# UPDATES_DIR=/path/to/updates

# --- Ретеншн истории ------------------------------------------------
# Сколько хранятся сообщения и вложения. Единица задаётся суффиксом —
# тот же формат, что у JWT_TTL:
#   RETENTION=30m   — 30 минут (эфемерный чат)
#   RETENTION=12h   — 12 часов
#   RETENTION=10d   — 10 дней
#   RETENTION=90    — без суффикса читается как ДНИ
# По умолчанию 90 дней. Всё, что старше, чистится фоновой задачей;
# частота подметания подстраивается под окно (четверть окна, но не чаще
# раза в 30 секунд и не реже раза в час).
# RETENTION=90d

# Старое имя. Всегда означает дни, продолжает работать. Если заданы обе
# переменные, побеждает RETENTION.
# RETENTION_DAYS=90

# --- Web Push (опционально) ----------------------------------------
# При первом старте сервер сам генерирует VAPID-пару и сохраняет в
# server/data/vapid.json — настраивать руками не обязательно. Если
# хочется задать ключи фиксированно (например, при миграции на новый
# сервер с уже подписанными клиентами), пропиши их здесь:
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:admin@example.com

# --- 152-ФЗ / Privacy (опционально) --------------------------------
# Если разворачиваешь сервер на домене в зонах .ru/.рф/.su и пользователи
# не только ты сам — формально нужен оператор ПДн и страница политики.
# Заполни оба поля ниже, чтобы на сервере появилась страница /privacy и
# на странице регистрации — ссылка на неё. Если поля пустые, модуль
# выключен и ничего не рендерится.
# PRIVACY_OPERATOR_NAME="ИП Иванов Иван Иванович"
# PRIVACY_OPERATOR_EMAIL=privacy@sazcord.example.com
# PRIVACY_OPERATOR_ADDRESS="г. Москва, ул. Примерная, 1"
# Дата последней редакции (опц.; иначе берётся текущая на момент рендера).
# PRIVACY_LAST_UPDATED=2026-04-29
# Требовать чекбокс согласия при регистрации (1/true/yes). Имеет смысл
# включать только если PRIVACY_OPERATOR_NAME+EMAIL заданы. Время согласия
# сохраняется в users.privacy_consent_at для compliance-аудита.
# REQUIRE_PRIVACY_CONSENT=1

# --- STUN / TURN (опционально) --------------------------------------
# STUN нужен, чтобы клиенты узнали свой внешний адрес. По умолчанию
# используются публичные серверы Google — этого хватает в ~80% случаев.
# Переопредели, если Google недоступен в твоей сети или не хочется
# зависеть от чужого сервиса. Формат: CSV из stun:host:port.
# Пустое значение = без STUN вообще; осмысленно только вместе с TURN.
# STUN_URLS=stun:stun.example.com:3478,stun:stun2.example.com:3478

# Если у пользователей строгий NAT (corporate, мобильные CGNAT),
# голос/видео могут не подключаться даже со STUN — тогда нужен TURN.
# Подними coturn рядом и подставь URL+креды:
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=sazcord
# TURN_PASSWORD=replace-me

# --- Кто кого видит --------------------------------------------------
# local (по умолчанию) — все видят всех. Новый зарегистрировавшийся сразу
#   появляется в списке у каждого. Так вёл себя Sazcord всегда; правильный
#   режим для домашнего инстанса на несколько знакомых.
#
# private — видно только тех, с кем есть связь: принятые друзья ЛИБО
#   участие в общей группе. Правила работают объединением, как в Discord.
#   Новый пользователь не видит никого и не виден никому, пока связь не
#   появится. Это же ограничивает личные сообщения, звонки и историю.
#
# ВАЖНО при переключении local -> private на живом сервере: дружб в базе
# ещё нет, и все разом останутся без контактов. Сначала прогони
#   npm run migrate:friends            (сухой прогон, покажет что будет)
#   npm run migrate:friends -- --apply (записать)
# — она превратит существующие личные переписки во взаимные дружбы.
# SAZCORD_SOCIAL_MODE=local

# --- Лимиты содержимого ---------------------------------------------
# Максимальная длина текста сообщения в символах. По умолчанию 4000.
# MESSAGE_MAX_CHARS=4000

# Сколько участников влезает в группу, считая владельца. По умолчанию 10 —
# для домашних посиделок хватает, для публичного инстанса обычно мало.
# MAX_GROUP_MEMBERS=10

# Максимальная длина названия группы. По умолчанию 64.
# GROUP_NAME_MAX=64

# Сколько файлов можно приложить к одному сообщению. По умолчанию 10.
# Отдельно от MAX_UPLOAD_MB: тот режет размер КАЖДОГО файла, этот — их
# количество. Вместе задают потолок одного запроса.
# MAX_FILES_PER_MESSAGE=10

# Минимальная длина пароля. По умолчанию 6. Ниже шести не опустится —
# это уже не настройка, а дыра.
# MIN_PASSWORD_LENGTH=6

# --- Звонки ----------------------------------------------------------
# Сколько секунд звоним, прежде чем пометить вызов пропущенным.
# CALL_RING_TIMEOUT_SEC=30

# Сколько секунд держим оборвавшийся звонок «живым», чтобы его можно
# было подхватить после переподключения. По умолчанию 300 (5 минут).
# CALL_RECONNECT_SEC=300

# --- Лимиты запросов ------------------------------------------------
# Защита login/register от перебора: сколько попыток с одного IP и за
# какое окно. Успешные логины не считаются. Дефолт — 10 попыток / 15 мин.
# Поднимать имеет смысл, если все клиенты приходят с одного IP (инстанс
# за корпоративным NAT); опускать — если публичный инстанс перебирают.
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AUTH_WINDOW_MIN=15

# Общий потолок на /api/* — запросов с IP в минуту. Дефолт 600 (~10 rps).
# Это страховка от зациклившегося клиента, а не от настоящего DoS:
# настоящий должен гаситься на nginx/cloudflare выше по стеку.
# RATE_LIMIT_API_MAX=600

# --- Мониторинг -----------------------------------------------------
# Ниже какого свободного места (МБ) в разделе с uploads эндпоинт
# /api/health начинает отдавать статус degraded. Дефолт 200.
# HEALTH_LOW_DISK_MB=200
